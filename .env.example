# Feature flags
# Public feature flags are exposed to the client, so use them for UI and route gating only.
# Runtime defaults are defined in src/lib/config/feature-flags.ts.
# The sample values below mirror the current defaults and can be edited locally.

PUBLIC_FEATURE_DOCS=true
PUBLIC_FEATURE_PRICING=false
PUBLIC_FEATURE_RESOURCES=true
PUBLIC_FEATURE_RELEASE_HISTORY=false

# Marketing analytics
# Leave blank to disable analytics locally. When enabled, the shared analytics layer
# will bootstrap the selected provider and emit marketing pageview and CTA events.
# Production should use the canonical Kwipoo PostHog project.
# Preview and development should use the separate Kwipoo Staging project.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_SCRIPT_URL=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Premium signup wiring
# If checkout is set, the Premium flow can hand off directly into payment.
# If checkout is blank and signup is set, the flow hands off to account creation or in-app upgrade.
# If both are blank, Premium falls back to direct contact.
# For local flow review, you can point checkout at /pricing/premium/mock-checkout.
PUBLIC_PREMIUM_CHECKOUT_URL=
PUBLIC_PREMIUM_SIGNUP_URL=
