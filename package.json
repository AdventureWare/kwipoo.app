{
  "name": "kwipoo.app",
  "private": true,
  "version": "0.0.17",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run content:sync:if-available && vite dev",
    "build": "npm run content:sync:if-available && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && husky",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "changeset": "changeset",
    "content:sync:if-available": "node scripts/sync-app-docs-reference.mjs --if-available && node scripts/sync-app-releases.mjs --if-available",
    "docs:sync": "node scripts/sync-app-docs-reference.mjs",
    "docs:check": "node scripts/sync-app-docs-reference.mjs --check",
    "releases:sync": "node scripts/sync-app-releases.mjs",
    "releases:check": "node scripts/sync-app-releases.mjs --check",
    "theme:sync": "node scripts/sync-app-theme.mjs",
    "theme:check": "node scripts/sync-app-theme.mjs --check",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "npm run lint:prettier && npm run lint:eslint",
    "lint:staged": "lint-staged",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run test:e2e:full",
    "test:e2e:ci": "npm run test:e2e:full:ci",
    "test:e2e:smoke": "npm run build && node scripts/run-playwright-preview.mjs --grep @smoke --project=preview-desktop",
    "test:e2e:smoke:ci": "playwright test --grep @smoke --project=preview-desktop",
    "test:e2e:full": "npm run build && node scripts/run-playwright-preview.mjs --grep @smoke",
    "test:e2e:full:ci": "playwright test --grep @smoke",
    "test:e2e:desktop": "npm run build && node scripts/run-playwright-preview.mjs --grep @smoke --project=preview-desktop",
    "test:e2e:mobile": "npm run build && node scripts/run-playwright-preview.mjs --grep @smoke --project=preview-mobile",
    "test:e2e:narrow": "npm run build && node scripts/run-playwright-preview.mjs --grep @smoke --project=preview-narrow-mobile"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.55.0",
    "@skeletonlabs/skeleton": "^4.13.0",
    "@skeletonlabs/skeleton-svelte": "^4.13.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "{src,tests}/**/*.{js,ts,svelte}": "eslint"
  },
  "dependencies": {
    "phosphor-svelte": "^3.0.1"
  }
}
